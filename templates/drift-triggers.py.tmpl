# ------------------------------------------------------- per-kind probes
# active_check answers "is the trigger wired?" -> True | False | None
# (None = cannot determine; treated as unverifiable, not missing).

def cron_check(ref: str) -> tuple[bool | None, str]:
    """ref is matched as substring against ACTIVE (non-commented) lines
    of `crontab -l`. A commented-out '# MIGRATED ...' block counts as
    migrated, not missing — document intentional removals in the comment
    so the checker doesn't flag them."""
    raw = crontab_lines()
    migrated = False
    for line in raw:
        s = line.strip()
        if not s:
            continue
        if s.startswith("#"):
            if "MIGRATED" in s.upper():
                migrated = True
            continue
        if ref and ref in s:
            return True, f"crontab:{ref}"
    if migrated:
        return False, f"migrated:{ref}"
    return False, f"crontab:{ref}"


def systemd_timer_check(ref: str) -> tuple[bool | None, str]:
    return (ref in timers(), f"timer:{ref}")


def systemd_service_check(ref: str) -> tuple[bool | None, str]:
    _out, rc = sh(f"systemctl --user is-active {ref} 2>/dev/null")
    return (rc == 0, f"service:{ref}")


def process_check(ref: str) -> tuple[bool | None, str]:
    """ref = regex for `pgrep -f`. The '--' keeps refs starting with '-'
    from being parsed as pgrep options."""
    _out, rc = sh(f"pgrep -f -- '{ref}' >/dev/null 2>&1", timeout=10)
    return (rc == 0, f"pgrep:{ref[:50]}")


def active_check(tr: dict) -> tuple[bool | None, str]:
    """Dispatch on trigger kind. TODO(adopt): register YOUR kinds —
    webhook, queue-consumer, IDE-extension, CI-workflow, etc."""
    kind, ref = tr.get("kind"), str(tr.get("ref") or "")
    if kind == "cron":
        return cron_check(ref)
    if kind == "systemd-timer":
        return systemd_timer_check(ref)
    if kind == "systemd-service":
        return systemd_service_check(ref)
    if kind == "process":
        return process_check(ref)
    # TODO(adopt): kinds that can't be probed locally (SaaS schedules,
    # external CI) should return (None, "unverifiable:<kind>") — honest
    # UNVERIFIABLE beats a fake MISSING.
    return (None, f"unknown-kind:{kind}")


def last_run_check(tr: dict) -> tuple[float | None, str]:
    """When did this trigger last fire? -> (epoch|None, detail).

    Dispatch on evidence.source. TODO(adopt): implement the sources your
    manifest uses; the examples below cover the common ones."""
    ev = tr.get("evidence") or {}
    src, key = ev.get("source"), str(ev.get("key") or "")
    if src == "file-mtime":
        # key may be 'a|b' alternatives — first hit wins
        for k in key.split("|"):
            m = file_mtime(k.strip())
            if m:
                return m, f"mtime:{k}"
        return None, f"mtime:{key} missing"
    if src in ("manual", "none"):
        return None, f"{src}:{key}"
    # TODO(adopt):
    #   source: heartbeat  -> your run-events ledger, key = tool name
    #   source: journalctl -> journal_last(key) for systemd units
    #   source: executions -> dispatcher/hook-fires ledger
    #   source: log        -> mtime of a log the job appends to
    return (None, f"evidence-unknown:{src}")


def classify(tr: dict, tool: dict) -> tuple[str, str, float | None]:
    """(status, detail, last_ts) for ONE trigger declaration.

    Decision tree — the heart of the check:

    active=False + 'migrated' in detail -> MIGRATED (intentional move)
    active=False                    -> MISSING  (declared, not wired)
    non-temporal expected           -> OK if active else UNVERIFIABLE
    temporal expected, never fired  -> DRYRUN if effect_mode is
                                       dry-run/report-only else SILENT
    fired within 2x interval        -> OK (or DRYRUN if effect_mode says so)
    fired but stale                 -> SILENT (or DRYRUN likewise)
    """
    expected = str(tr.get("expected") or "unknown")
    emode = tr.get("effect_mode") or "real"
    active, adetail = active_check(tr)
    last_ts, ldetail = last_run_check(tr)

    if active is False:
        if "migrated" in adetail:
            return "MIGRATED", f"trigger migrado p/ nativo ({adetail})", last_ts
        return "MISSING", f"trigger inactivo ({adetail})", last_ts

    freq_s = expected_seconds(expected)
    if freq_s is None:
        if expected in ("always-on", "every-session"):
            if active is True:
                return "OK", f"active ({adetail})", last_ts
            if active is False:
                return "MISSING", f"deveria estar activo ({adetail})", last_ts
            return "UNVERIFIABLE", f"always-on não confirmável ({adetail})", last_ts
        # manual / on-demand / unknown / on-change
        if active is True:
            return "UNVERIFIABLE", (f"trigger activo mas recência não "
                                    f"auditável ({adetail})"), last_ts
        return "OK", f"manual/declared ({adetail})", last_ts

    # temporal expected: needs last_run evidence
    if last_ts is None:
        if emode in ("dry-run", "report-only"):
            return "DRYRUN", f"nunca corrido (dry-run) [{ldetail}]", None
        return "SILENT", f"nunca executou [{ldetail}] (esperado {expected})", None
    age = NOW - last_ts
    window = freq_s * 2  # 2x grace: timers drift, cron has jitter
    if age <= window:
        if emode in ("dry-run", "report-only"):
            return "DRYRUN", f"corre mas efeito nulo por design ({ldetail})", last_ts
        return "OK", f"última há {age/3600:.1f}h ({ldetail})", last_ts
    if emode in ("dry-run", "report-only"):
        return "DRYRUN", f"última há {age/86400:.1f}d — dry-run ({ldetail})", last_ts
    return "SILENT", (f"última há {age/86400:.1f}d > {window/86400:.1f}d "
                      f"({ldetail})"), last_ts


def worst(statuses: list[str]) -> str:
    return max(statuses, key=lambda s: SEV_ORDER.get(s, 0)) if statuses else "UNVERIFIABLE"


# ------------------------------------------------------- phantom/competing
# TODO(adopt): implement for YOUR platform. The pattern:
#   - enumerate REAL triggers from the OS (crontab lines, systemd units,
#     running processes, hook configs, MCP server lists)
#   - subtract the manifest's declared refs -> PHANTOM candidates
#   - group declared tools by `domain`; >1 tool sharing a domain with
#     temporal expected frequencies -> COMPETING (allow opt-out via a
#     documented `skip_competition: true` + `competition_note`)

def collect_phantoms(declared_refs: dict) -> list[tuple[str, str]]:
    """Real triggers not declared in the manifest -> [(kind, name)]."""
    phantoms: list[tuple[str, str]] = []
    # TODO(adopt): e.g. scan crontab_lines() for `hb run <name>` /
    # script paths not present in declared_refs["cron"]/["script"], and
    # `systemctl --user list-timers` for undeclared *.timer units.
    return phantoms


def collect_competing(tools: list[dict]) -> tuple[list, dict]:
    """Domains claimed by >1 tool -> (pairs, skipped_with_reason)."""
    by_domain: dict[str, list] = {}
    skipped = {}
    for t in tools:
        dom = t.get("domain")
        if not dom:
            continue
        if t.get("skip_competition"):
            skipped[t["name"]] = t.get("competition_note", "")
            continue
        for tr in t.get("triggers", []):
            exp = str(tr.get("expected") or "")
            if exp in UNVERIFIABLE_FREQ or exp == "always-on":
                continue
            by_domain.setdefault(dom, []).append((t["name"], exp))
    pairs = []
    for dom, members in by_domain.items():
        names = sorted({n for n, _ in members})
        if len(names) > 1:
            exps = {e for _, e in members}
            pairs.append((dom, names, sorted(exps)))
    return pairs, skipped


# ------------------------------------------------------------- main

def run(manifest_path: Path = MANIFEST) -> int:
    try:
        doc = yaml.safe_load(Path(manifest_path).read_text())
    except Exception as e:
        print(f"drift-triggers: FATAL manifest ilegível: {e}",
              file=sys.stderr)
        return 2
    tools = (doc or {}).get("tools") or []
    lines: list[dict] = []
    summary = {s: 0 for s in
               ("OK", "SILENT", "NO_EFFECT", "MISSING", "DRYRUN",
                "UNVERIFIABLE", "PHANTOM", "COMPETING", "MIGRATED",
                "DISABLED")}

    # declared refs per kind — needed by phantom detection
    declared: dict[str, set] = {}
    # TODO(adopt): fill declared[kind] with the ref strings your
    # collect_phantoms compares against.

    for tool in tools:
        name = tool.get("name", "?")
        trs = tool.get("triggers") or []
        if tool.get("status") == "disabled":
            lines.append({"class": "triggers", "check": name, "tool": name,
                          "ok": True, "status": "DISABLED",
                          "detail": "desactivado de propósito "
                                    f"({tool.get('notes') or 'sem motivo'})",
                          "violations": [], "count": 0})
            summary["DISABLED"] += 1
            continue
        if not trs:
            lines.append({"class": "triggers", "check": name, "tool": name,
                          "ok": True, "status": "UNVERIFIABLE",
                          "detail": "sem triggers declarados",
                          "violations": [], "count": 0})
            summary["UNVERIFIABLE"] += 1
            continue
        statuses, details = [], []
        for tr in trs:
            st, det, _lts = classify(tr, tool)
            statuses.append(st)
            details.append(f"{tr.get('kind')}:{tr.get('ref')}={st}")
        bad = [s for s in statuses
               if s not in ("OK", "DRYRUN", "MIGRATED", "DISABLED")]
        ok = worst(statuses) in ("OK", "DRYRUN", "UNVERIFIABLE",
                                 "MIGRATED", "DISABLED")
        wst = worst(statuses)
        lines.append({"class": "triggers", "check": name, "tool": name,
                      "ok": ok, "status": wst,
                      "detail": "; ".join(details)[:600],
                      "violations": bad, "count": len(bad)})
        summary[wst] = summary.get(wst, 0) + 1

    for kind, name in collect_phantoms(declared):
        lines.append({"class": "triggers", "check": f"phantom:{name}",
                      "tool": name, "ok": False, "status": "PHANTOM",
                      "detail": f"trigger real ({kind}) não declarado",
                      "violations": ["PHANTOM"], "count": 1})
        summary["PHANTOM"] += 1

    comp_pairs, comp_skipped = collect_competing(tools)
    for dom, names, exps in comp_pairs:
        lines.append({"class": "triggers", "check": f"competing:{dom}",
                      "tool": ",".join(names), "ok": False,
                      "status": "COMPETING",
                      "detail": f"domain={dom} tools={names} expected={exps}",
                      "violations": ["COMPETING"], "count": 1})
        summary["COMPETING"] += 1

    ts = datetime.now(timezone.utc).isoformat()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    OUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    for ln in lines:
        ln["ts"] = ts
        jsonl_append(OUT_PATH, ln)

    nviol = sum(1 for ln in lines if ln["count"] > 0)
    print(f"drift-triggers: {len(tools)} tools, {nviol} com issues "
          f"(SILENT={summary['SILENT']} MISSING={summary['MISSING']} "
          f"PHANTOM={summary['PHANTOM']} COMPETING={summary['COMPETING']})")
    return 0 if nviol == 0 else 1


if __name__ == "__main__":
    sys.exit(run())
