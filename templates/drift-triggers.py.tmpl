#!/usr/bin/env python3
"""drift-triggers — SKELETON: declared triggers vs observed firings.

WHY this check exists
---------------------
A manifest that says "tool X runs every 20 min" is a claim, not a fact.
Triggers rot in a specific way: the cron line survives but the script it
calls was deleted; the systemd timer exists but the unit is masked; the
hook is wired but the handler exits early. The tool *looks* configured
and simply never fires — SILENT drift, invisible until the report that
was supposed to arrive doesn't.

This checker closes the loop: for every declared trigger it asks two
independent questions —

1. **active?**   is the trigger wired in the OS/agent config at all?
2. **fired?**    when did it last produce observable evidence?

and classifies the answer. It also looks the other way: triggers that
exist in reality but were never declared (PHANTOM), and declared tools
whose domains overlap (COMPETING — usually an accident of history where
two mechanisms do the same job).

Classification taxonomy (tool-level status = worst of its triggers):

- ``OK``            — active AND fired within ~2x the expected interval.
- ``SILENT``        — active but hasn't fired within the window (or ever).
                      The dangerous one: configured, dead.
- ``MISSING``       — declared but the trigger is not active in the OS.
- ``MIGRATED``      — local trigger intentionally removed; the job moved
                      to a native platform feature (documented move).
- ``DISABLED``      — tool deliberately off (owner decision, with reason).
- ``DRYRUN``        — fires on schedule but produces no real effect by
                      design (calibration/report-only mode).
- ``NO_EFFECT``     — fires, evidence exists, but the declared effect is
                      absent (TODO: needs effect-level evidence, harder).
- ``PHANTOM``       — a real trigger found in the OS that the manifest
                      never declared (undeclared automation = un-audited).
- ``COMPETING``     — 2+ tools claim the same domain with overlapping
                      schedules; pick one, document the loser.
- ``UNVERIFIABLE``  — manual/on-demand/always-on triggers, or evidence
                      sources this checker can't read. Honest, not green.

Manifest shape (``triggers.yaml``)::

    tools:
      - name: nightly-report
        type: cron-job                # cosmetic grouping only
        domain: reporting             # COMPETING detection key
        status: enabled               # or "disabled" -> DISABLED class
        triggers:
          - kind: cron                # TODO(adopt): see KINDS below
            ref: nightly-report       # what to look for in `crontab -l`
            expected: daily           # frequency vocabulary below
            evidence: { source: log, key: "~/logs/nightly.log" }
        notes: "what it does and why it exists"

This file is a SKELETON: the classification state machine below is real
and generic; the evidence loaders and per-kind probes are TODO stubs you
must adapt to YOUR manifest's ``kind`` vocabulary and evidence sources.
"""

from __future__ import annotations

import json
import os
import re
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import yaml

from lib.cmd import run as cmd_run
from lib.jsonl import append as jsonl_append
from lib.xdg import drift_state_dir

ECOSYSTEM_ROOT = Path(os.environ.get(
    "ECOSYSTEM_ROOT",
    str(Path(__file__).resolve().parent.parent),
))
MANIFEST = Path(os.environ.get("TRIGGERS_MANIFEST",
                              ECOSYSTEM_ROOT / "triggers.yaml"))
STATE_DIR = drift_state_dir(env_override="DRIFT_STATE_DIR")
OUT_PATH = Path(os.environ.get("DRIFT_OUT", STATE_DIR / "drift.jsonl"))
NOW = time.time()

# Frequency vocabulary -> seconds. "a|b" means "the shorter wins" (the
# most sensitive window). Non-temporal frequencies map to None.
EXPECTED_S = {
    "3min": 180, "5min": 300, "15min": 900, "20min": 1200, "30min": 1800,
    "40min": 2400, "hourly": 3600, "2hourly": 7200, "3hourly": 10800,
    "daily": 86400, "weekly": 604800, "monthly": 2592000,
    "every-session": None, "always-on": None, "manual": None,
    "on-demand": None, "unknown": None, "on-change": None,
}
UNVERIFIABLE_FREQ = {"every-session", "always-on", "manual", "on-demand",
                     "unknown", "on-change"}

# Worst-first severity for rolling trigger statuses up to a tool status.
SEV_ORDER = {"OK": 0, "MIGRATED": 0, "DISABLED": 0, "UNVERIFIABLE": 1,
             "DRYRUN": 2, "SILENT": 3, "NO_EFFECT": 4, "MISSING": 5,
             "PHANTOM": 5, "COMPETING": 5}


def sh(cmd: str, timeout: int = 15) -> tuple[str, int]:
    """Fail-open shell runner: (stdout, rc). Never raises."""
    rc, out, _e = cmd_run(cmd, timeout=timeout, shell=True)
    return out, rc


def expected_seconds(expected: str) -> float | None:
    """'40min'->2400, 'daily'->86400, 'every-session'->None.
    'daily|weekly' -> min (shortest frequency = most sensitive window)."""
    e = str(expected or "unknown").strip().lower()
    parts = [p.strip() for p in e.split("|") if p.strip()] or [e]
    vals = []
    for p in parts:
        if p in EXPECTED_S:
            v = EXPECTED_S[p]
        else:
            m = re.fullmatch(r"(\d+)\s*(min|h|d|s)", p)
            v = (int(m.group(1)) * {"s": 1, "min": 60,
                                    "h": 3600, "d": 86400}[m.group(2)]
                 if m else None)
        if v is not None:
            vals.append(v)
    return min(vals) if vals else None


# ---------------------------------------------------------- evidence
# TODO(adopt): implement loaders for YOUR evidence sources. The contract
# is simple: each returns enough to answer "when did this last fire?"
# (epoch float or None) and caches per run.

_cache: dict[str, object] = {}


def crontab_lines() -> list[str]:
    if "cron" not in _cache:
        out, _rc = sh("crontab -l 2>/dev/null")
        _cache["cron"] = out.splitlines()
    return _cache["cron"]  # type: ignore[return-value]


def timers() -> str:
    if "timers" not in _cache:
        out, _rc = sh("systemctl --user list-timers --all --no-pager "
                      "2>/dev/null")
        _cache["timers"] = out
    return _cache["timers"]  # type: ignore[return-value]


def file_mtime(path: str) -> float | None:
    """mtime epoch of a file, or max-mtime inside a dir (bounded walk)."""
    p = os.path.expanduser(path)
    try:
        if os.path.isfile(p):
            return os.path.getmtime(p)
        if os.path.isdir(p):
            best = os.path.getmtime(p)
            n = 0
            for root, _dirs, files in os.walk(p):
                for fn in files:
                    try:
                        m = os.path.getmtime(os.path.join(root, fn))
                        if m > best:
                            best = m
                    except OSError:
                        pass
                    n += 1
                    if n > 3000:
                        return best
            return best
        return None
    except OSError:
        return None


def parse_ts(v) -> float | None:
    """epoch from ISO string or numeric timestamp."""
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return float(v)
    try:
        return datetime.fromisoformat(
            str(v).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


